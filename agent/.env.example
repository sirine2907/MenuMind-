# --- LLM provider ------------------------------------------------------------
# ollama (default, local & free) | openai | azure_openai | anthropic | gemini | mock
LLM_PROVIDER=ollama
# Optional: override the provider's default model
# LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
# Use the scripted demo model when the provider is unreachable / not configured
LLM_FALLBACK_TO_MOCK=true

# Ollama: qwen2.5:7b (~4.7 GB, needs ~8 GB RAM). Low-RAM machines: llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (pip extra: openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI (pip extra: openai)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic (pip extra: anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini (pip extra: gemini)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- MenuMind API ------------------------------------------------------------
LARAVEL_API_URL=http://localhost:8080/api
AGENT_SHARED_SECRET=change-me
