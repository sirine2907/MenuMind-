APP_NAME=MenuMind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# `php artisan serve` workers. The agent calls back into this API while a
# chat request is still open, so more than one worker is required.
PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker compose). For a quick local run without Docker you can
# use DB_CONNECTION=sqlite instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=menumind
DB_USERNAME=menumind
DB_PASSWORD=menumind

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@menumind.tn"
MAIL_FROM_NAME="${APP_NAME}"

# Typesense (hybrid search). Embeddings are computed by Typesense itself with
# the built-in ts/all-MiniLM-L12-v2 model, no external API involved.
TYPESENSE_ENABLED=true
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=menumind-dev-key
TYPESENSE_EMBEDDING_MODEL=ts/all-MiniLM-L12-v2
TYPESENSE_HYBRID_ALPHA=0.4

# Agent service (Python / LangGraph)
AGENT_URL=http://127.0.0.1:8000
AGENT_TIMEOUT=180
AGENT_SHARED_SECRET=change-me

# Swagger UI
L5_SWAGGER_CONST_HOST=http://localhost:8080
L5_SWAGGER_GENERATE_ALWAYS=false
