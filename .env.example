# Copy to .env to customise `docker compose up`. Every value has a working default.

# --- LLM ------------------------------------------------------------------------
# ollama (default, local & free) | openai | azure_openai | anthropic | gemini | mock
LLM_PROVIDER=ollama
# qwen2.5:7b needs ~8 GB of RAM. On smaller machines use llama3.2:3b.
OLLAMA_MODEL=qwen2.5:7b
# Answer with the scripted demo model while the real one is unreachable
LLM_FALLBACK_TO_MOCK=true

# Switching to OpenAI = 2 variables:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Azure OpenAI:
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Anthropic / Gemini:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Infrastructure -------------------------------------------------------------
POSTGRES_PASSWORD=menumind
TYPESENSE_API_KEY=menumind-dev-key
AGENT_SHARED_SECRET=menumind-local-secret
# Leave empty to generate one at start-up
APP_KEY=
